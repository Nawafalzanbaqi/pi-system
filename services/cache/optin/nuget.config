<?xml version="1.0" encoding="utf-8"?>
<!--
  ===========================================================================
  pi-system  |  OPTIONAL local NuGet cache (BaGetter) opt-in
  ...........................................................................
  Written into a project's backend by new-project.sh when the package-cache
  opt-in flag is passed (or copy this file there yourself). It points
  `dotnet restore` at the platform's local NuGet cache, which mirrors
  (read-through) nuget.org.

  The <clear /> below drops the inherited nuget.org source so restores go ONLY
  through the cache; because the cache MIRRORS nuget.org, every public package
  still resolves: the first restore warms it, later restores are local.

  This is a HARD opt-in: while this file is present, restore WILL use the cache,
  so the cache must be running (./scripts/cache.sh up) AND reachable on the
  `internal` Docker network. See services/cache/README.md and docs/README.md
  "Package cache" for the build-network note and the graceful (env/CLI) opt-in
  that needs no committed file. To fall back to nuget.org, DELETE this file.
  ===========================================================================
-->
<configuration>
  <packageSources>
    <clear />
    <add key="pi-cache" value="http://nuget-cache:8080/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
