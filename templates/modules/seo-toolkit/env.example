# seo-toolkit — empty env templates (mirrors the `env:` list in module.manifest).
# The generator appends these (blank) to the project's .env.example section.
#
# These are read at request time, SERVER-SIDE only (by app/sitemap.js, app/robots.js,
# the buildMetadata helper and the StructuredData component) — they are NOT
# NEXT_PUBLIC_ vars, so they are never bundled into client JS. Fill them in .env
# (never commit values). The site still builds with them blank (sane fallbacks),
# but set SEO_SITE_URL so canonical/Open-Graph URLs and the sitemap are absolute.

# The site's full public URL (no trailing slash), e.g. https://teeth.example.com.
# Used for absolute canonical + Open Graph URLs and the sitemap entries.
# TIP for hosting MANY sites: instead of this shared value you may set a PER-PROJECT
# override named <PREFIX>SEO_SITE_URL (the project's env prefix, e.g.
# ACME_SEO_SITE_URL) — the compose fragment prefers it, falling back to this one.
SEO_SITE_URL=

# The site / brand name, used as the <title> fallback and in Open Graph + JSON-LD.
SEO_SITE_NAME=

# Locales for the sitemap + hreflang alternates (comma/space separated). Defaults to
# "ar,en" to match the i18n-bilingual module. For a single-language site, set this to
# just that locale (e.g. "ar") so the sitemap emits one un-prefixed set of URLs.
SEO_LOCALES=
