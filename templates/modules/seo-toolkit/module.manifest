# ===========================================================================
# pi-system module declaration — see ../README.md for the full contract.
# Line-based "key: value" so the generator parses it with plain shell (no YAML).
# ===========================================================================

# Identifier (must equal this folder's name).
name: seo-toolkit

# One line describing what the module does.
description: On-page SEO defaults a site should have — meta tags + Open Graph, a bilingual sitemap.xml & robots.txt, and JSON-LD structured-data scaffolding — cooperating with i18n. The optional AI lives in the audit engine, not here.

# implemented = the generator composes it in. planned = skipped + recorded as a TODO.
status: implemented

# Base shapes this module supports (comma-separated, or "all").
# It layers SEO assets onto a Next.js frontend, so it composes for the bases that
# HAVE one:
#   nextjs-app  -> the assets at the app root (app/sitemap.js, app/robots.js, lib/seo).
#   fullstack   -> the same, under the frontend/ subtree (the web-facing service).
# A dotnet-api base has NO Next.js frontend, so it is INCOMPATIBLE and is skipped +
# recorded in PROJECT.md. For a .NET site, add the equivalent server-side (a
# /sitemap.xml + /robots.txt endpoint and <meta>/OG tags) — see this module's README.
base_compatible: nextjs-app, fullstack

# Database engine this module needs: postgres | mysql | mongo | none.
# None — these are static-ish, request-time SEO assets; nothing is persisted.
database: none

# External account / approved API keys required to activate, or "none".
# None. The on-page SEO defaults need no account. (The OPTIONAL AI enrichment is a
# property of the AUDIT engine — services/seo / .env AI_PROVIDER+AI_API_KEY — NOT of
# the generated site, so it does not belong to this module.)
external_credentials: none

# Env vars this module needs, as EMPTY templates (names only), or "none".
# The generator appends these (blank) to the project's .env.example section. They
# are read at request time (server-side only — never bundled into client JS):
#   SEO_SITE_URL    the site's full public URL, e.g. https://teeth.example.com — used
#                   for absolute canonical/OG URLs + the sitemap. Per project you may
#                   instead set <PREFIX>SEO_SITE_URL (the compose fragment prefers it).
#   SEO_SITE_NAME   the site/brand name for <title> fallback, OG and JSON-LD.
#   SEO_LOCALES     comma/space locales for the sitemap/hreflang (default: ar,en —
#                   matches i18n-bilingual). Set to a single locale for a 1-language site.
env: SEO_SITE_URL, SEO_SITE_NAME, SEO_LOCALES

# Source files this module layers onto the project (relative path), or "none".
# Per-base subtrees only, so each base gets the assets at the right path:
# files/nextjs-app (app root) and files/fullstack (under frontend/). The module is
# STRICTLY ADDITIVE — every file is NEW (app/sitemap.js, app/robots.js, lib/seo/*,
# components/StructuredData.jsx). It NEVER replaces a layout/page/template, so it
# cooperates cleanly with i18n-bilingual, auth-sso and web-analytics (no collisions).
files: files

# Compose fragment this module contributes (relative path), or "none".
# A DIRECTORY of per-base fragments (compose/<base>.compose.yml) — the same per-base
# idea as files/<base>/. Each MERGES the SEO_* env into the project's existing web
# service (whose name differs by base: __PROJECT_NAME__ vs __PROJECT_NAME__-web).
# It adds NO new container and NO host ports.
compose: compose

# Caddy snippet this module adds to the project's site block (relative path), or "none".
# None: sitemap.xml / robots.txt are served by the Next.js app itself (Next's
# app/sitemap.js + app/robots.js conventions), under the project's existing route —
# so no extra Caddy route and no new host ports.
caddy_routes: none
