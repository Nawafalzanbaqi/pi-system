<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ========================================================================
       __PROJECT_NAME__ — REPLACES the base app.csproj when the bookings module is
       composed in. Identical to the base, plus:
         * the Npgsql PostgreSQL driver (pure-managed, ARM64-safe; pinned), used
           by the bookings data access (Bookings/BookingsRepository.cs);
         * a copy rule so the idempotent SQL migrations ship next to the published
           app, where BookingsMigrator reads them on startup.
       ===================================================================== -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Fixed assembly name so the Docker ENTRYPOINT (dotnet app.dll) is stable
         regardless of the chosen project name (__PROJECT_NAME__). -->
    <AssemblyName>app</AssemblyName>
    <!-- Matches DOTNET_SYSTEM_GLOBALIZATION_INVARIANT in the Dockerfile so the
         slim Alpine runtime needs no ICU. Npgsql works fine under invariant
         globalization (ordinal comparisons, UTC timestamps). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- bookings module: PostgreSQL access. Pinned (never floating). -->
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- bookings module: publish the SQL migrations so they sit at
         <app>/Bookings/migrations/*.sql for BookingsMigrator to apply. Using
         <None Update> (the files are already None items by SDK default) avoids a
         duplicate-item error. -->
    <None Update="Bookings/migrations/*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
