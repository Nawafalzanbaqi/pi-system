# ===========================================================================
# pi-system module declaration — see ../README.md for the full contract.
# Line-based "key: value" so the generator parses it with plain shell (no YAML).
# ===========================================================================

# Identifier (must equal this folder's name).
name: local-payments

# One line describing what the module does.
description: Local payment checkout (mada / Apple Pay / cards) via a swappable provider — a mock that simulates the full lifecycle by default, Moyasar (Saudi market) when credentials are supplied.

# implemented = the generator composes it in. planned = skipped + recorded as a TODO.
status: implemented

# Base shapes this module supports (comma-separated, or "all").
# It composes for EVERY base, but each base gets DIFFERENT pieces (per-base files/
# and compose/ fragments below):
#   dotnet-api  -> the .NET payment service: create-intent + status + the
#                  signature-verified webhook + (mock only) a simulate-pay endpoint.
#   fullstack   -> the .NET payment service in the BACKEND (the source of truth —
#                  it records intents/status and verifies webhooks) PLUS a Next.js
#                  checkout page + return page in the frontend. The end-to-end shape
#                  used by the ecommerce preset.
#   nextjs-app  -> the Next.js checkout + return-page UI calling a payments backend
#                  over PAYMENTS_API_URL. The lifecycle/webhook/DB live in the .NET
#                  service, so on a backend-less nextjs-app this is a documented
#                  integration point (degrades gracefully) — see this module's README.
base_compatible: all

# Database engine this module needs: postgres | mysql | mongo | none.
# Postgres. It records payment intents + their status in the PROJECT's own database
# (ConnectionStrings__Default -> postgres:5432, built by the generator from the
# shared .env credentials — no secrets here, no dedicated container), so status is
# durable and webhook handling is IDEMPOTENT (no double-credit). It is fully
# functional with `--db postgres` (the ecommerce preset default). For `--db mysql`,
# `mongo` or `none` it degrades gracefully (the .NET service stays healthy and the
# payment endpoints report the feature is unavailable) — see the README's
# "Database & fallbacks".
database: postgres

# External account / approved API keys required to activate, or "none".
# REQUIRED to go LIVE — but NOT to build or run: the default `mock` provider
# simulates the WHOLE lifecycle locally (create -> pay -> signed webhook -> mark
# paid -> status), so the flow is testable now with zero merchant accounts.
# Switching PAYMENTS_PROVIDER to `moyasar` requires a Moyasar merchant account: an
# API secret key, and a webhook secret token. These are DEFERRED, one-time,
# operator-run steps — see this module's SETUP.md. The real provider is fully coded
# but stays INERT until those env values are present.
external_credentials: required — Moyasar merchant account: PAYMENTS_API_KEY (secret key) + PAYMENTS_WEBHOOK_SECRET (webhook secret token). See SETUP.md. Not needed for the default mock provider.

# Env vars this module needs, as EMPTY templates (names only), or "none".
# The generator appends these (blank) to the project's .env.example section. Left
# blank, the provider defaults to `mock` (the compose fragments use ${VAR:-mock}),
# so the full lifecycle works with no credentials. All are filled in .env (never
# committed):
#   PAYMENTS_PROVIDER       mock | moyasar  (blank => mock — the safe default)
#   PAYMENTS_API_KEY        Moyasar: the secret API key (Basic auth) — go-live only
#   PAYMENTS_PUBLISHABLE_KEY Moyasar: publishable key (optional; client-side form)
#   PAYMENTS_WEBHOOK_SECRET webhook authenticity secret (Moyasar secret_token; the
#                           mock also uses it to HMAC-sign its simulated webhook)
#   PAYMENTS_CURRENCY       ISO currency for new payments (defaults to SAR)
#   PAYMENTS_API_URL        nextjs-app only: URL of the payments backend (integration point)
env: PAYMENTS_PROVIDER, PAYMENTS_API_KEY, PAYMENTS_PUBLISHABLE_KEY, PAYMENTS_WEBHOOK_SECRET, PAYMENTS_CURRENCY, PAYMENTS_API_URL

# Source files this module layers onto the project (relative path), or "none".
# Per-base subtrees only (no generic tree). The .NET half is ADDITIVE — it ships a
# Payments/PaymentsHostingStartup.cs ([assembly:HostingStartup]) + a
# Directory.Build.targets that conditionally adds the Npgsql driver — WITHOUT
# replacing the base's Program.cs / app.csproj. It therefore composes cleanly with
# bookings (which owns those + already references Npgsql; the .targets skips it then)
# and auth-sso (which ships Directory.Build.props — a different file). See the
# README, "How it composes with other modules".
files: files

# Compose fragment this module contributes (relative path), or "none".
# A DIRECTORY of per-base fragments (compose/<base>.compose.yml). Each MERGES the
# PAYMENTS_* env into the project's existing service(s) (whose names differ by base:
# <name> vs <name>-api / <name>-web), sets ASPNETCORE_HOSTINGSTARTUPASSEMBLIES=app
# to activate the additive .NET service, and derives the public URLs (callback /
# webhook) from the subdomain. It adds NO new container and NO host ports.
compose: compose

# Caddy snippet this module adds to the project's site block (relative path), or "none".
# None: create / status / webhook live under the app's own /api/payments/* routes
# and the checkout/return pages under existing routes — all already fronted by the
# project's base reverse_proxy. The webhook URL you register with the provider is
# just https://<subdomain>.<BASE_DOMAIN>/api/payments/webhook — see SETUP.md.
caddy_routes: none
