# ===========================================================================
# local-payments — environment templates (EMPTY values only; never commit real
# secrets). The generator appends these to the project's section in the root
# .env.example; copy them into .env and fill the ones you need.
# ---------------------------------------------------------------------------
# Leave PAYMENTS_PROVIDER blank (or "mock") to run with the built-in MOCK provider:
# it simulates the WHOLE payment lifecycle locally (create -> pay -> signed webhook
# -> mark paid -> status), so the flow works with NO merchant account. Set
# PAYMENTS_PROVIDER=moyasar and fill the Moyasar values to take real payments
# (mada / Apple Pay / cards) — see SETUP.md for the one-time steps.
# ===========================================================================

# mock | moyasar   (blank => mock; the safe default for local + first deploy)
PAYMENTS_PROVIDER=

# --- Moyasar — required only when PAYMENTS_PROVIDER=moyasar ------------------
# The SECRET API key (sk_live_... / sk_test_...). Used as HTTP Basic auth username.
PAYMENTS_API_KEY=
# The PUBLISHABLE key (pk_live_... / pk_test_...). OPTIONAL — only for a client-side
# Moyasar.js form; the server-side hosted-invoice flow shipped here does not need it.
PAYMENTS_PUBLISHABLE_KEY=

# --- Webhook authenticity (used by mock AND moyasar) ------------------------
# moyasar: the "secret token" you set on the webhook in the Moyasar dashboard (it is
#          echoed in every webhook payload and compared here).
# mock:    the key used to HMAC-sign the simulated webhook (defaults to a dev value
#          if blank, so the mock works out of the box).
PAYMENTS_WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------
# ISO currency code for new payments (defaults to SAR if blank).
PAYMENTS_CURRENCY=

# nextjs-app base ONLY: URL of the .NET payments backend that owns the lifecycle.
# (On fullstack the frontend uses BACKEND_URL automatically; on dotnet-api the
# service IS the backend.) See this module's README, "nextjs-app integration".
PAYMENTS_API_URL=
