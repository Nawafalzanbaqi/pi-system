# ===========================================================================
# whatsapp-integration — environment templates (EMPTY values only; never commit
# real secrets). The generator appends these to the project's section in the root
# .env.example; copy them into .env and fill the ones you need.
# ---------------------------------------------------------------------------
# Leave WHATSAPP_PROVIDER blank (or "mock") to run with the built-in MOCK sender:
# it logs/echoes the message and returns success, so the whole flow works with NO
# external account. Set WHATSAPP_PROVIDER=cloud_api and fill the Cloud API values
# (from Meta) to send real WhatsApp messages — see SETUP.md for the one-time steps.
# ===========================================================================

# mock | cloud_api   (blank => mock; the safe default for local + first deploy)
WHATSAPP_PROVIDER=

# --- WhatsApp Cloud API (Meta) — required only when WHATSAPP_PROVIDER=cloud_api --
# The business phone number id (Meta -> WhatsApp -> API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# A permanent access token for the system user (NOT the temporary 24h token).
WHATSAPP_ACCESS_TOKEN=

# --- Inbound webhook (optional — only if you receive messages / status events) --
# A token YOU choose and also enter in Meta's webhook config (echoed back on verify).
WHATSAPP_VERIFY_TOKEN=
# The Meta App secret — used to verify the X-Hub-Signature-256 on inbound POSTs.
WHATSAPP_APP_SECRET=

# --- Optional ---------------------------------------------------------------
# Graph API version for the Cloud API (defaults to a pinned version if blank).
WHATSAPP_API_VERSION=
