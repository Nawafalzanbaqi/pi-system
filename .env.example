# ===========================================================================
# pi-system — environment template
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values:
#     cp .env.example .env
#
# This is a TEMPLATE: every value is intentionally left blank. Suggested
# values are shown in the comments. NEVER put real secrets/passwords here —
# the real .env file is git-ignored; this .env.example is committed.
# ===========================================================================

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
# Compose project name; prefixes resource names. (suggested: pi-system)
COMPOSE_PROJECT_NAME=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Names of the two base Docker networks.
#   (suggested: pi_internal)
INTERNAL_NETWORK_NAME=
#   (suggested: pi_proxy)
PROXY_NETWORK_NAME=
# Subnets in CIDR notation. Keep the two ranges non-overlapping.
#   (suggested: 172.20.0.0/16)
INTERNAL_SUBNET=
#   (suggested: 172.21.0.0/16)
PROXY_SUBNET=

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
# IANA timezone name. (suggested: Asia/Riyadh — or Europe/London, UTC, ...)
TZ=

# ---------------------------------------------------------------------------
# Data paths (host paths on the SSD)
# ---------------------------------------------------------------------------
# Root for persistent service data/volumes. (suggested: ./data)
DATA_ROOT=
# Root for service configuration files. (suggested: ./data/config)
CONFIG_ROOT=
# Root from which secret files are mounted. (suggested: ./secrets)
SECRETS_ROOT=

# ---------------------------------------------------------------------------
# MANAGEMENT & MONITORING
# ---------------------------------------------------------------------------
# Used by infrastructure/management.compose.yml — Portainer (management UI),
# Uptime Kuma (uptime monitoring) and Watchtower (NOTIFY-ONLY update checker
# that reports available image updates but never auto-updates containers).
#
# Watchtower update-check schedule. 6-field cron: sec min hour day-of-month
# month day-of-week. Runs in the TZ set above.
#   (suggested: 0 0 4 * * 0   — every Sunday at 04:00)
WATCHTOWER_SCHEDULE=
# Where Watchtower sends its update reports: a shoutrrr notification URL.
# Leave BLANK to disable notifications (it will still log what it finds).
# This may embed a token/password, so keep the real value in .env only.
#   (e.g. telegram://<token>@telegram?chats=<chat-id>  |  smtp://user:pass@host:port/?from=..&to=..)
WATCHTOWER_NOTIFICATION_URL=

# ---------------------------------------------------------------------------
# REVERSE PROXY
# ---------------------------------------------------------------------------
# Used by services/proxy/proxy.compose.yml — Caddy is the single public entry
# point. It terminates TLS and routes subdomains of BASE_DOMAIN to each UI:
#   portainer.<BASE_DOMAIN> -> Portainer    status.<BASE_DOMAIN> -> Uptime Kuma
#
# Base domain that every service subdomain hangs off. Leave BLANK for local
# use: it falls back to "localhost", so the UIs answer at
# https://portainer.localhost and https://status.localhost with a
# locally-trusted certificate from Caddy's internal CA.
#   (local: leave blank  |  public: e.g. example.com)
BASE_DOMAIN=
# ACME account e-mail for PUBLIC Let's Encrypt certificates. Leave BLANK to use
# Caddy's internal CA (the local fallback — needs no public domain). Set this
# ONLY once BASE_DOMAIN is a real, internet-resolvable domain pointed at this
# Pi; that switches every site to automatic public HTTPS.
# Blank => Caddy uses its internal CA (compose collapses it to "internal").
#   (e.g. you@example.com)
ACME_EMAIL=

# --- OPTIONAL: direct/bootstrap host ports ---------------------------------
# Only needed if you uncomment a "Bootstrap access" block in
# management.compose.yml for EMERGENCY direct access (e.g. the reverse proxy is
# down). Normally leave blank — the services stay proxy-only.
#   (suggested: 9000)
PORTAINER_HTTP_PORT=
#   (suggested: 3001)
UPTIME_KUMA_PORT=

# ---------------------------------------------------------------------------
# DATABASES
# ---------------------------------------------------------------------------
# Used by services/databases/databases.compose.yml. Each engine is OPTIONAL and
# starts only on demand via its Compose profile — e.g. ./scripts/db.sh postgres up.
# Fill in ONLY the engine(s) a project actually uses. Databases are internal-
# only (no host ports) and are reached by other containers via their service
# name: postgres:5432, mysql:3306, mongo:27017, redis:6379.
# Use long, random values — these are real credentials. NEVER commit real ones.

# --- PostgreSQL (profile: postgres) — recommended relational engine ---------
#   (suggested: appuser)
POSTGRES_USER=
# Required by the image. Generate a strong random secret.
POSTGRES_PASSWORD=
# Initial database created on first launch. (suggested: appdb)
POSTGRES_DB=

# --- MySQL (profile: mysql) ------------------------------------------------
# Password for the MySQL 'root' superuser. Required by the image.
MYSQL_ROOT_PASSWORD=
# Initial database created on first launch. (suggested: appdb)
MYSQL_DATABASE=
# Non-root application user granted access to MYSQL_DATABASE. (suggested: appuser)
MYSQL_USER=
# Password for MYSQL_USER.
MYSQL_PASSWORD=

# --- MongoDB (profile: mongo) ----------------------------------------------
# Root username + password created on first launch. (user suggested: appadmin)
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
# Initial database to create/seed. (suggested: appdb)
MONGO_INITDB_DATABASE=

# --- Redis (profile: redis) ------------------------------------------------
# Auth password (applied via --requirepass). Required: do NOT leave blank, or
# Redis would run unauthenticated on the internal network.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# DATABASE ADMIN UIs
# ---------------------------------------------------------------------------
# Used by services/db-admin/db-admin.compose.yml — OPTIONAL, on-demand visual
# admin UIs, each behind its own Compose profile (start with
# ./scripts/db-admin.sh <ui> up). They publish NO host ports and are reached
# only via Caddy: pgadmin.<BASE_DOMAIN>, adminer.<BASE_DOMAIN>,
# mongo-express.<BASE_DOMAIN>. Start the matching DATABASE profile first.
# Fill in ONLY the UI(s) you actually use. Use long, random secrets.

# --- pgAdmin (profile: pgadmin) — PostgreSQL ------------------------------
# Initial administrator login for the pgAdmin web UI. The e-mail MUST be a
# valid e-mail format (it is the username). (suggested: admin@example.com)
PGADMIN_DEFAULT_EMAIL=
# Strong random secret for that pgAdmin login.
PGADMIN_DEFAULT_PASSWORD=

# --- Adminer (profile: adminer) — MySQL & PostgreSQL ----------------------
# OPTIONAL convenience: pre-fills the "Server" field on Adminer's login page.
# Leave BLANK to type it yourself. (suggested: postgres — or mysql)
ADMINER_DEFAULT_SERVER=

# --- Mongo Express (profile: mongo-express) — MongoDB ---------------------
# HTTP basic-auth that protects the Mongo Express web UI itself (separate from
# the MongoDB credentials). Required — do NOT leave blank, or the UI would be
# unauthenticated behind Caddy. (user suggested: mongoadmin)
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=
# NOTE: Mongo Express connects to MongoDB using the root credentials from the
# DATABASES section above (MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD)
# — no separate connection variables are needed here.

# ---------------------------------------------------------------------------
# AUTHENTICATION (KEYCLOAK)
# ---------------------------------------------------------------------------
# Used by services/auth/auth.compose.yml — Keycloak, the centralized SSO / OIDC
# identity provider, plus its OWN dedicated, internal-only PostgreSQL instance
# (service name keycloak-db — NOT the shared engines in the DATABASES section).
# Keycloak publishes NO host ports and is reached only via Caddy at
# auth.<BASE_DOMAIN>. It is the HEAVIEST service on the Pi (JVM) — start it on
# demand and stop it when idle; see docs/README.md. Start with ./scripts/auth.sh up.
# Use long, random secrets. NEVER commit real values.

# --- Keycloak's dedicated PostgreSQL (service: keycloak-db) ----------------
# These three values are shared by keycloak-db (consumed as POSTGRES_*) and by
# Keycloak (as its KC_DB_* connection settings). Isolated from the shared
# DATABASES above — Keycloak keeps its identity data in its own store.
# Initial database created on first launch. (suggested: keycloak)
KC_DB_NAME=
# Database user that owns it. (suggested: keycloak)
KC_DB_USERNAME=
# Required by the image. Generate a strong random secret.
KC_DB_PASSWORD=

# --- Keycloak bootstrap admin (FIRST-LOGIN setup only) ---------------------
# Temporary initial admin account created on first startup. After first login,
# create a permanent admin user inside Keycloak and remove/disable this one.
#   (suggested: admin)
KC_BOOTSTRAP_ADMIN_USERNAME=
# Required. Generate a strong random secret.
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Keycloak hostname / proxy ---------------------------------------------
# External base URL Keycloak builds its links and tokens from. Leave BLANK for
# local use: Keycloak derives host + scheme from Caddy's forwarded headers and
# answers at https://auth.localhost. For PUBLIC use, set the full external URL
# (with https://) so redirects and issued tokens use a fixed, correct address.
#   (local: leave blank  |  public: https://auth.example.com)
KC_HOSTNAME=

# ---------------------------------------------------------------------------
# AUTOMATION (n8n)
# ---------------------------------------------------------------------------
# Used by services/automation/automation.compose.yml — n8n, the platform's
# central workflow automation engine, plus its OWN dedicated, internal-only
# PostgreSQL instance (service name n8n-db — NOT the shared engines in the
# DATABASES section, and NOT keycloak-db). n8n publishes NO host ports and is
# reached only via Caddy at automation.<BASE_DOMAIN>. It is a moderately heavy
# Node.js service — start it on demand. Start with ./scripts/automation.sh up.
# Use long, random secrets. NEVER commit real values.

# --- n8n's dedicated PostgreSQL (service: n8n-db) --------------------------
# These three values are shared by n8n-db (consumed as POSTGRES_*) and by n8n
# (as its DB_POSTGRESDB_* connection settings). Isolated from the shared
# DATABASES above — n8n keeps its workflow/execution data in its own store.
# Initial database created on first launch. (suggested: n8n)
N8N_DB_NAME=
# Database user that owns it. (suggested: n8n)
N8N_DB_USERNAME=
# Required by the image. Generate a strong random secret.
N8N_DB_PASSWORD=

# --- n8n credential encryption (CRITICAL) ----------------------------------
# n8n encrypts EVERY stored credential with this key. It must stay STABLE and
# SECRET for the life of the instance:
#   * Lose it  -> every saved credential becomes permanently UNRECOVERABLE.
#   * Leak it  -> stored credentials can be decrypted by anyone who has it.
# scripts/check-secrets.sh flags a missing value here as CRITICAL. Generate a
# strong random key once and back it up OFFLINE alongside your other keys, e.g.:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- n8n hostname / webhook URL (reverse-proxy / edge mode) ----------------
# External hostname n8n believes it is served at (NO protocol). Leave BLANK for
# local use: it defaults to automation.localhost (reached via Caddy with its
# internal CA). For PUBLIC use set the real host.
#   (local: leave blank  |  public: automation.example.com)
N8N_HOST=
# Full external base URL (WITH https:// and a trailing slash) that n8n uses to
# build webhook URLs and editor links. Must match the address you open in the
# browser, otherwise webhooks register the wrong URL. Leave BLANK for local use
# (defaults to https://automation.localhost/).
#   (local: leave blank  |  public: https://automation.example.com/)
N8N_WEBHOOK_URL=
# NOTE on access control: n8n's OWN built-in user management guards the editor —
# on first boot you create an owner account (email + password). There is no
# env-based basic auth in modern n8n; if you want an extra gate you can layer
# Caddy basic_auth or Keycloak in front later (see docs/README.md). n8n binds
# NO host ports, so it is only ever reachable through Caddy regardless.

# ---------------------------------------------------------------------------
# TELEGRAM BOT (management + alerts — OPTIONAL, runs as an n8n workflow)
# ---------------------------------------------------------------------------
# Drives automation/workflows/telegram-management-bot.json: a LIGHTWEIGHT,
# operator-only bot to monitor/control the platform from Telegram. It adds NO
# new container and NO paid AI — commands are deterministic, executed through the
# audited bridge scripts/bot-exec.sh. SECURITY: the bot is locked to an ALLOWLIST
# of Telegram user ids; an empty allowlist authorizes NO ONE (fail closed).
#
# This is a DEFERRED, one-time MANUAL setup (it needs an external account):
#   1. Talk to @BotFather, run /newbot, copy the bot TOKEN.
#   2. Find YOUR numeric Telegram user id (e.g. message @userinfobot).
#   3. Fill the two values below, then restart n8n so it sees TELEGRAM_ALLOWED_IDS.
# See docs/README.md "Telegram management bot". NEVER commit real values.

# --- Bot token (from BotFather) --------------------------------------------
# The HTTP API token for your bot. In n8n this is normally stored as a Telegram
# API CREDENTIAL (more secure) rather than read from here; it is listed so
# scripts/check-secrets.sh can warn if a token exists with an EMPTY allowlist.
# Leave BLANK if you are not using the bot.
#   (e.g. 123456789:AAExampleExampleExampleExampleExampleExa)
TELEGRAM_BOT_TOKEN=

# --- Allowlist of permitted Telegram user ids (REQUIRED if using the bot) ---
# Comma- or space-separated NUMERIC user ids that may command the bot. The n8n
# workflow reads this as $env.TELEGRAM_ALLOWED_IDS and refuses everyone else.
# DO NOT leave this blank while TELEGRAM_BOT_TOKEN is set — an allowlist-less bot
# would be an open control channel (check-secrets.sh flags exactly that).
#   (e.g. 111222333   or   111222333,444555666)
TELEGRAM_ALLOWED_IDS=

# --- Outbound alert chat (OPTIONAL — for scripts/notify-telegram.sh) --------
# scripts/notify-telegram.sh delivers WARN/FAIL alerts (host health, SEO, prospects)
# to YOUR Telegram. Wire it with HEALTH_NOTIFY_CMD / SEO_NOTIFY_CMD / PROSPECTS_NOTIFY_CMD
# (below / in their sections) = ./scripts/notify-telegram.sh . It sends to this chat id;
# if blank it falls back to the FIRST id in TELEGRAM_ALLOWED_IDS (the chat you already
# control the bot from). Numeric chat id (a user id, or a group/channel id).
TELEGRAM_ALERT_CHAT_ID=

# --- Bridge knobs (OPTIONAL; sensible defaults) ----------------------------
# Absolute path to scripts/bot-exec.sh as seen by the n8n SSH node / host. Only
# set this if your install path is not the default below.
#   (e.g. /opt/pi-system/scripts/bot-exec.sh)
PI_BOT_EXEC=
# Audit log for every bridge invocation (timestamp + action + result). Under the
# git-ignored ./data. Leave BLANK for the default ./data/bot/bot-exec.log.
TELEGRAM_BOT_EXEC_LOG=

# ---------------------------------------------------------------------------
# BACKUP & RESTORE
# ---------------------------------------------------------------------------
# Used by services/backup/ and scripts/backup*.sh / restore.sh. The backup job
# is a one-shot, internal-only container (Compose profile "backup", NO host
# ports) that connects to each database BY SERVICE NAME, dumps every engine that
# is running with its proper tool, and writes an ENCRYPTED artifact. Its
# defining feature is TESTED RESTORE: a weekly drill restores the latest backup
# into DISPOSABLE throwaway containers and fails loudly if it cannot.
#
#   ./scripts/backup.sh init-key   # generate the key (once) — KEEP A COPY OFFLINE
#   ./scripts/backup.sh now        # back up now      ./scripts/backup.sh verify
#   ./scripts/backup-install-cron.sh   # schedule daily backup + weekly drill

# --- Encryption (REQUIRED — no plaintext dumps are ever written) -----------
# age identity (PRIVATE key) file. Generated by `./scripts/backup.sh init-key`
# and git-ignored (it lives under ./secrets, which is ignored). The PUBLIC
# recipient is derived from it automatically. This file is REQUIRED to restore
# AND for the weekly drill — copy it somewhere SAFE and OFFLINE; if you lose it,
# every backup is unrecoverable. NEVER commit it.
#   (suggested: ./secrets/backup/age-identity.key)
BACKUP_AGE_KEY_FILE=./secrets/backup/age-identity.key
# OPTIONAL: encrypt to explicit age PUBLIC key(s) instead of deriving them from
# the identity above (comma- or space-separated). Lets the Pi hold only the
# public key for backups while the private key stays offline. Leave BLANK to
# derive the recipient from BACKUP_AGE_KEY_FILE.
#   (e.g. age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p)
BACKUP_AGE_RECIPIENTS=

# --- Storage + retention ---------------------------------------------------
# Host directory for the encrypted backups (under git-ignored ./data). Easy to
# inspect, prune and rsync offsite. (suggested: ./data/backups)
BACKUP_DIR=./data/backups
# Rotation: how many daily and weekly snapshots to keep (older ones are pruned).
#   (suggested: 7)
BACKUP_RETENTION_DAILY=7
#   (suggested: 4)
BACKUP_RETENTION_WEEKLY=4

# --- Extra project databases (OPTIONAL) ------------------------------------
# Databases beyond the core engines — e.g. a generated project's dedicated DB.
# content-admin ships its own Postgres named "<project>-cms-db". Whitespace-
# separated list; each entry has SIX colon-separated fields:
#   engine:host:port:db:user:PASSWORD_ENV_VAR
# The LAST field NAMES another variable in THIS .env that holds the password
# (the password itself never appears here). engine is postgres | mysql | mongo.
#   (example for a project "clinic" using content-admin's CMS database:)
#   BACKUP_EXTRA_TARGETS=postgres:clinic-cms-db:5432:directus:directus:CMS_DB_PASSWORD
BACKUP_EXTRA_TARGETS=

# --- Monitoring (OPTIONAL) -------------------------------------------------
# Uptime Kuma "Push" monitor URLs. If set, the backup / drill push an "up"
# heartbeat on success (and "down" on failure) so a missed/failed run is
# noticed. Leave BLANK to rely on the on-disk status files + logs instead.
# Create a Push monitor in Uptime Kuma and paste its push URL here.
#   (e.g. https://status.<BASE_DOMAIN>/api/push/<token>)
BACKUP_UPTIME_KUMA_PUSH_URL=
BACKUP_VERIFY_UPTIME_KUMA_PUSH_URL=

# Failure NOTIFIER (OPTIONAL). When a scheduled backup OR the offsite push fails,
# './scripts/backup.sh now' surfaces it through this swappable notifier seam so a
# silent backup failure can't go unnoticed. Contract: a short LABEL on argv, the
# message BODY on stdin (the same seam HEALTH_NOTIFY_CMD/SEO_NOTIFY_CMD use), so the
# bundled Telegram sender delivers it to YOUR operator chat. Leave BLANK to use that
# default (gated — a no-op until TELEGRAM_BOT_TOKEN + a chat id are set); set "off" to
# disable entirely. Best-effort: a failed/unconfigured notifier never fails the backup.
#   (default when blank: ./scripts/notify-telegram.sh)
BACKUP_NOTIFY_CMD=

# --- Offsite copy (OPTIONAL — built-in rclone push) ------------------------
# The core backup works fully LOCALLY with no external account. To ALSO copy the
# encrypted backups offsite (recommended for real disaster recovery), set these three
# and the daily './scripts/backup.sh now' will push them automatically (or run
# './scripts/backup.sh offsite' on demand). The artifacts are already age-encrypted, so
# the destination NEVER sees plaintext or the key. Push is `rclone copy` (it never
# deletes at the destination). Left blank = no offsite (a clean no-op). Install rclone
# on the Pi and create the remote once with:  rclone --config <CONFIG> config
#   BACKUP_OFFSITE_TYPE     the tool — currently only 'rclone' is supported
BACKUP_OFFSITE_TYPE=
#   BACKUP_OFFSITE_REMOTE   rclone remote:path destination   (e.g. b2:my-pi-backups)
BACKUP_OFFSITE_REMOTE=
#   BACKUP_OFFSITE_CONFIG   path to the rclone config (git-ignored; default
#                           ./secrets/backup/rclone.conf)
BACKUP_OFFSITE_CONFIG=

# ---------------------------------------------------------------------------
# HOST HEALTH MONITORING (OPTIONAL — read by scripts/health-monitor.sh)
# ---------------------------------------------------------------------------
# A lightweight, READ-ONLY probe of the Pi HARDWARE (CPU temperature/throttling,
# disk usage, live memory/swap, per-container memory). It runs from host cron
# (./scripts/health-monitor-install-cron.sh), writes a status file + log, and on
# WARN/FAIL fires a swappable notifier. Every value here is OPTIONAL: the script
# has sane built-in defaults, so leaving these blank is fine. They exist so the
# SCHEDULED run (which does not source this file) still picks up your tuning —
# health-monitor.sh reads these specific keys from .env directly.
# Intentionally lightweight: NO Grafana/Prometheus/agent. See docs/README.md
# "Resource monitoring".
#
# --- Thresholds (WARN at the first, FAIL at the second) --------------------
# CPU temperature °C. Pi 5 soft-throttles ~80°C, hard ~85°C. (suggested: 70 / 80)
HEALTH_TEMP_WARN=
HEALTH_TEMP_FAIL=
# Disk usage % full, for / and the Docker data dir.       (suggested: 80 / 90)
HEALTH_DISK_WARN=
HEALTH_DISK_FAIL=
# RAM used % of total.                                     (suggested: 85 / 95)
HEALTH_MEM_WARN=
HEALTH_MEM_FAIL=
# Swap used % of swap total (heavy swap = RAM pressure).   (suggested: 50 / 80)
HEALTH_SWAP_WARN=
HEALTH_SWAP_FAIL=
# Per-container memory as % of that container's OWN limit
# ("near its limit").                                      (suggested: 85 / 95)
HEALTH_CTR_WARN=
HEALTH_CTR_FAIL=
#
# --- Where it writes + what it watches -------------------------------------
# Directory for last-health.json + health.log (under git-ignored ./data).
#   (suggested: ./data/health)
HEALTH_STATUS_DIR=
# Docker's data-root, sized for disk pressure. (suggested: /var/lib/docker)
DOCKER_DATA_DIR=
#
# --- Alerting (SWAPPABLE; no secrets in git) -------------------------------
# Default safe channel needs NO config: WARN/FAIL writes data/health/last-alert.txt
# (and the status file) for Uptime Kuma / the operator to watch. To also push to
# Uptime Kuma, create a "Push" monitor and paste its URL here (FAIL => down,
# WARN/PASS => up). The URL may embed a token, so keep the real value in .env only.
#   (e.g. https://status.<BASE_DOMAIN>/api/push/<token>)
HEALTH_UPTIME_KUMA_PUSH_URL=
# To route alerts to Telegram, set this to the bundled sender:
#   HEALTH_NOTIFY_CMD=./scripts/notify-telegram.sh
# (it reads TELEGRAM_BOT_TOKEN + TELEGRAM_ALERT_CHAT_ID/ALLOWED_IDS above and sends to
# YOUR chat). Or point it at any script of your own — it is called as <cmd> <VERDICT>
# with the alert body on stdin; keep custom tokens inside that script, never here.
HEALTH_NOTIFY_CMD=

# ---------------------------------------------------------------------------
# DASHBOARD (Homepage)
# ---------------------------------------------------------------------------
# Used by services/dashboard/dashboard.compose.yml — Homepage, the unified
# landing page that links to (and health-checks) every platform service. It
# publishes NO host ports and is reached only via Caddy at home.<BASE_DOMAIN>.
# Start with ./scripts/dashboard.sh up.
#
# The dashboard needs NO secrets to run: its config (services/dashboard/config)
# is committed and secret-free, and the hostname it answers on is derived
# automatically from BASE_DOMAIN above (home.<BASE_DOMAIN>; home.localhost when
# BASE_DOMAIN is blank). There is therefore nothing you MUST set here.
#
# The variables below are OPTIONAL: they are only for Homepage "widgets" that
# talk to a service's API and need a key. The committed config keeps any such
# widget COMMENTED OUT, so leaving these blank is perfectly fine — you just get
# the simple, credential-free up/down health dots instead. Add more the same
# way: define HOMEPAGE_VAR_<NAME> here, pass it through in dashboard.compose.yml,
# and reference it as {{HOMEPAGE_VAR_<NAME>}} in the config. NEVER commit a key.

# --- OPTIONAL: Portainer widget API token ----------------------------------
# Enables the richer Portainer widget (running/stopped container counts) on the
# dashboard. Create an access token in Portainer (Settings -> Access tokens) and
# paste it here, then uncomment the `widget:` block under Portainer in
# services/dashboard/config/services.yaml. Leave BLANK to keep the plain
# siteMonitor health dot (no credentials needed).
HOMEPAGE_VAR_PORTAINER_KEY=

# ---------------------------------------------------------------------------
# QUALITY GATE
# ---------------------------------------------------------------------------
# Used by ./scripts/quality.sh — a lightweight, on-demand quality gate for the
# projects you generate (see services/quality/README.md). It is SCRIPT-DRIVEN
# and runs its checks in throwaway, pinned ARM64 SDK containers, SEQUENTIALLY
# (gentle on the Pi), so it consumes NO RAM unless you run it. It needs NO
# secrets. The two knobs below are OPTIONAL — leave blank to use the defaults.

# --- OPTIONAL: treat .NET build warnings (incl. Roslyn analyzers) as errors --
# 'true' (default) makes any compiler/analyzer warning fail the .NET analyze
# check. Set to 'false' to report analyzer findings without failing the build.
QUALITY_DOTNET_WARN_AS_ERROR=

# --- OPTIONAL: npm audit severity threshold --------------------------------
# low | moderate | high | critical. The npm audit check fails when a
# vulnerability at/above this level is found. Default (blank) = high.
QUALITY_NPM_AUDIT_LEVEL=

# ---------------------------------------------------------------------------
# PACKAGE CACHE
# ---------------------------------------------------------------------------
# Used by services/cache/cache.compose.yml — an OPTIONAL local cache for npm
# (Verdaccio) and NuGet (BaGetter) that transparently mirrors + caches the
# public registries so repeated installs on the Pi are faster. Both sit behind
# the Compose profile "cache" and NEVER auto-start, so they use ZERO RAM until
# you run ./scripts/cache.sh up. A project OPTS IN (it is never forced) — see
# docs/README.md "Package cache". Reached over the `internal` network as
# verdaccio:4873 (npm) and nuget-cache:8080 (NuGet); Verdaccio's UI is fronted
# by Caddy at cache.<BASE_DOMAIN>. Everything below is OPTIONAL.

# --- OPTIONAL: Verdaccio public URL (behind the proxy) ---------------------
# Absolute URL of the Verdaccio UI when behind Caddy. Leave BLANK — Verdaccio
# also derives it from Caddy's forwarded headers. (e.g. https://cache.<domain>)
VERDACCIO_PUBLIC_URL=

# --- OPTIONAL: NuGet cache publish API key ---------------------------------
# Only needed to PUSH your own packages to the NuGet cache (installs/restores
# never need it). Leave BLANK for a pure cache. If set, restart the cache and
# push with: dotnet nuget push -s http://nuget-cache:8080/v3/index.json -k <key>
NUGET_CACHE_API_KEY=

# ---------------------------------------------------------------------------
# ANALYTICS (web analytics — Umami)
# ---------------------------------------------------------------------------
# Used by services/analytics/analytics.compose.yml — Umami, a lightweight,
# self-hosted, PRIVACY-FIRST web-analytics engine, plus its OWN dedicated,
# internal-only PostgreSQL instance (service name umami-db — NOT the shared
# engines in the DATABASES section, and NOT keycloak-db / n8n-db). Umami publishes
# NO host ports and is reached only via Caddy at analytics.<BASE_DOMAIN>. It sits
# behind the Compose profile "analytics" and NEVER auto-starts, so it uses ZERO
# RAM until you run ./scripts/analytics.sh up. It needs NO external account: it
# replaces Google Analytics with a tracker you fully own. A project OPTS IN via the
# web-analytics module (never forced) — see docs/README.md "Web analytics".
# Use long, random secrets. NEVER commit real values.

# --- Umami's dedicated PostgreSQL (service: umami-db) -----------------------
# Password for the bundled, internal-only analytics PostgreSQL. The user/database
# names are non-secret literals ("umami"); only this password comes from .env.
# Required by the image. Generate a strong random secret.
ANALYTICS_DB_PASSWORD=

# --- Umami app secret (CRITICAL) -------------------------------------------
# Umami signs its auth tokens / hashes with this key. It must stay STABLE and
# SECRET for the life of the instance (change it and existing logins break).
# Generate a strong random value once, e.g.:  openssl rand -hex 32
ANALYTICS_APP_SECRET=

# ---------------------------------------------------------------------------
# SEO & SITE QUALITY (auditor + recommendations — OPTIONAL, on-demand)
# ---------------------------------------------------------------------------
# Used by services/seo/seo.compose.yml + ./scripts/seo.sh — the on-demand auditor
# for the sites you OWN (your portfolio + the client sites you host). It scores each
# site (performance, SEO, accessibility, best-practices), stores results over time,
# and produces FREE, deterministic, rule-based recommendations. It runs as a ONE-SHOT
# container behind the Compose profile "seo" (NEVER auto-starts, ZERO RAM when idle)
# and is scheduled with ./scripts/seo-install-cron.sh. The DEFAULT path needs NO
# external credentials. NONE of the keys below are required for the free path; leave
# them blank and the auditor is fully functional. (These are NOT added to
# generate-secrets/check-secrets — like the other on-demand optional services.)
#
# The list of sites to audit is NOT here — it lives in data/seo/sites.conf (copy it
# from services/seo/sites.example.conf). Override that path with SEO_SITES_FILE.

# Where audit results are stored on the host (git-ignored). Default ./data/seo.
SEO_DATA_DIR=

# Path to your sites list (default: ./data/seo/sites.conf). Optional override.
SEO_SITES_FILE=

# Max bytes the no-browser probe will read from a single page response (default
# 5000000 = 5 MB). The probe already has a per-request TIME cap; this is the SIZE cap
# so a hostile or accidentally huge page can never exhaust the small audit container's
# memory — over the cap, that page is recorded as a failed audit. Optional; leave blank
# for the default.
SEO_PROBE_MAX_BYTES=

# --- OPTIONAL AI enrichment (swappable provider — OFF by default) -----------
# The recommendations engine is FREE and deterministic by default. To ALSO get
# deeper, AI-written suggestions, set BOTH of the next two. With either left blank
# the engine stays rule-based — no network call is ever made (the real provider is
# fully coded but INERT until a key is supplied). ⚠ When enabled, usage is billed on
# YOUR OWN account/key — no key is committed or required now.
#   AI_PROVIDER   openai | anthropic | compatible | none  (blank/none = rule-based)
#   AI_API_KEY    your own API key (REQUIRED to enable; usage-billed on your account)
#   AI_MODEL      model id (optional; a sane per-provider default is used if blank)
#   AI_BASE_URL   override the API base URL (optional; for self/compatible endpoints)
#   AI_TIMEOUT_MS request timeout in ms (optional; default 30000) — a hung provider
#                 can never stall the one-shot audit; it just degrades to rule-based.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=

# --- OPTIONAL PDF export of a report (OFF by default — Pi-aware) ------------
# `./scripts/seo.sh pdf <site>` builds the bilingual prospect report and ALWAYS
# writes a clean, print-ready HTML (+ the Markdown) under data/seo/reports/. A
# faithful HTML->PDF renderer is HEAVY (Chromium/Qt/Pango) and is NEVER bundled —
# leave SEO_PDF_RENDERER blank and you simply open the HTML and "Save as PDF" in any
# browser (zero Pi cost, perfect Arabic/RTL). To ALSO emit a .pdf, install a renderer
# module and name it here; it is dynamically imported and a missing/incompatible one
# degrades back to the Markdown + HTML. See services/seo/README.md → "Optional PDF export".
#   SEO_PDF_RENDERER   an INSTALLED renderer module name OR a path to a local renderer
#                      script (blank = HTML/Markdown only; missing module degrades safely)
#   SEO_REPORT_LOCALE  default report language: ar (default) | en  (overridable per run with --locale)
SEO_PDF_RENDERER=
SEO_REPORT_LOCALE=

# --- OPTIONAL notifier (shares the platform's alert channels) --------------
# After an audit, optionally push a one-line summary. All optional; with both blank
# the auditor just writes data/seo/last-summary.txt (which Uptime Kuma / the operator
# can watch). Mirrors the health-monitor swappable notifier.
#   SEO_UPTIME_KUMA_PUSH_URL   an Uptime Kuma "push" monitor URL (up/down by severity)
#   SEO_NOTIFY_CMD             your own command; the summary on stdin, verdict as $1
#                              (e.g. reuse the Telegram bot bridge). Keep tokens out of git.
SEO_UPTIME_KUMA_PUSH_URL=
SEO_NOTIFY_CMD=

# --- OPTIONAL re-audit monitoring (track EXISTING clients over time) --------
# `./scripts/seo.sh reaudit <site>` re-audits a site you already track and surfaces
# WHAT CHANGED vs the previous run: the report gains a "Changes since last audit"
# section, and a concise operator heads-up is pushed through the SAME gated notifier
# above ONLY on a MEANINGFUL change (a new critical/high finding, a tier drop, or the
# site going offline). It is operator-only (never the client), single-flight (shares
# the audit lock), and OFF by default. To monitor on a schedule, add a cron line, e.g.
# weekly:  0 6 * * 1  cd <project> && ./scripts/seo.sh reaudit happy-teeth >> data/seo/cron.log 2>&1
# (or 'reaudit' each site you host). Uses the free probe engine — gentle on the Pi.

# --- OPTIONAL content-idea engine (mine YOUR history for inbound topics) -----
# `./scripts/seo.sh content-ideas [--locale ar|en]` mines YOUR OWN accumulated audit
# history for recurring issue patterns and proposes data-backed, EDUCATIONAL content
# topics (bilingual ar/en) to attract inbound clients. It reads ONLY your local stores
# (data/seo/audits/*.jsonl + best-effort the prospects store) — it scrapes NOTHING and
# sends NOTHING; the ideas are general/educational, never about a named client. It reuses
# the SAME AI_* keys above and is INERT without a key (deterministic templates from your
# patterns, no network call). Optional: SEO_IDEAS_PER_SITE bounds how many recent audits
# per site are read (default 5).
SEO_IDEAS_PER_SITE=

# --- ANALYSIS DEPTH — one clear cost-vs-depth dial per run ------------------
# `seo.sh audit` and `prospects.sh analyze` accept `--depth <level>` to pick how
# DEEP — and how much AI cost — to spend on a single run. Same engine, same
# deterministic findings; depth only selects which OPTIONAL layers run on top.
#
#   quick     rules-only.  FREE — 0 AI calls.  The deterministic path on its own.
#   standard  ~1 AI call.  The existing single-call enrichment (ai.js enrich).
#   deep      ~7 AI calls. The full multi-specialist panel (see SEO_AI_PANEL below).
#
# Precedence (validated BEFORE Docker, so an unknown value never spends a container):
#   1. explicit --depth <level>             wins
#   2. legacy --panel                       treated as --depth deep (back-compat)
#   3. SEO_DEFAULT_DEPTH (this var)         pins the per-machine default
#   4. key-presence default                 `standard` when AI is set, else `quick`
#
# Leave SEO_DEFAULT_DEPTH blank to keep the key-presence default. Set it to one of
# quick | standard | deep to override (e.g. `quick` on the Pi to keep cost down
# even when an AI key is configured for other features). The chosen level is
# recorded on the audit + shown in the report header.
SEO_DEFAULT_DEPTH=

# --- OPTIONAL multi-specialist AI panel (the "technical team") --------------
# The panel makes an audit feel like a TEAM: a focused AI specialist per category
# (performance, security, SEO, accessibility, best-practices) PLUS a sales-angle analyst,
# then a lead-analyst synthesis that enforces ONE clear #1 priority + a unified action
# plan. It ENRICHES the existing deterministic report — operator-only, sends nothing.
# Hallucination-hardened: finding references are computed by US from real findings, any
# unverifiable model claim is shown as a "general suggestion" (not a detected issue), and
# any invented number is stripped (only real audit numbers survive).
#
# ⚠ COST — read this. The panel is OPT-IN and OFF by default precisely because it is
# MORE AI CALLS. A normal audit makes at most ONE AI call (the existing enrichment). With
# the panel ON it makes, PER AUDITED SITE, one call PER specialist (6: the five category
# analysts + the sales-angle analyst) PLUS one synthesis call ≈ up to 7 ADDITIONAL calls,
# billed on YOUR key. INERT without an AI key (deterministic templates, NO network calls).
# The panel is the `deep` level above — `--depth deep` and `--panel` are equivalent. Set
# SEO_AI_PANEL=1 to make --panel the default (same effect as SEO_DEFAULT_DEPTH=deep).
# Leave blank/0 to keep every audit single-call.
SEO_AI_PANEL=

# ---------------------------------------------------------------------------
# CLIENT PROSPECT ORGANIZER (manual CRM-lite + public-site analysis — OPTIONAL)
# ---------------------------------------------------------------------------
# Used by services/prospects/prospects.compose.yml + ./scripts/prospects.sh — a
# self-hosted, operator-owned CRM-lite for a MANUAL client-acquisition workflow.
# YOU find prospects yourself and enter them; the tool ORGANIZES the pipeline and
# ANALYZES a prospect's OWN public website by REUSING the SEO engine; then YOU
# contact them MANUALLY. It runs as a ONE-SHOT container behind the Compose profile
# "prospects" (NEVER auto-starts, ZERO RAM when idle). Growth layer #4.
#
# ⚠ BOUNDARY (architectural, not a toggle): NO scraping of Google Maps / LinkedIn /
# any platform; NO automated or bulk outreach; NO auto-send. There is no such code
# path in the image. Follow-up reminders below go to the OPERATOR (you), never to a
# prospect. The DEFAULT path needs NO external credentials — every var here is
# optional. (These are NOT added to generate-secrets/check-secrets — like the other
# on-demand optional services.)

# Where the pipeline + saved reports are stored on the host (git-ignored).
# Default ./data/prospects.
PROSPECTS_DATA_DIR=

# --- OPTIONAL AI enrichment of the analysis --------------------------------
# The analysis REUSES the SEO engine, including its swappable AI seam. It uses the
# SAME AI_PROVIDER / AI_API_KEY / AI_MODEL / AI_BASE_URL set in the SEO section
# above — there is nothing extra to configure here. With no key it stays rule-based
# (no network call is ever made; usage, when enabled, is billed on your own key).
#
# Those SAME keys also power the OPTIONAL `assist` action (./scripts/prospects.sh
# assist <id>): an ADVISORY AI decision-assist that suggests a lead-quality score, a
# next step from a fixed allowlist (research-more / prepare-offer / follow-up /
# deprioritize) and a one-line rationale, stored under the prospect's ai_assist. It is
# inert without a key and NEVER contacts anyone — it only advises YOU.
#
# And the OPTIONAL `draft` action (./scripts/prospects.sh draft <id>) reuses the very
# SAME AI_* keys to turn a completed audit into copy-paste-ready, bilingual (ar/en)
# OPERATOR drafts — a value-first outreach message (referencing the 1-2 biggest issues),
# a referral-request, and an educational content snippet, stored under the prospect's
# `drafts`. It is inert without a key (deterministic templates, no network call) and is
# DRAFTS-ONLY: the operator copies, edits, and SENDS them himself — nothing is ever sent.

# --- OPTIONAL operator alerts to the OPERATOR (never to a prospect) ----------
# The SAME swappable seam (mirroring the SEO/health-monitor notifier) carries TWO
# operator heads-ups to YOUR OWN channel — never to a prospect:
#   1. follow-ups due — `./scripts/prospects.sh followups --notify` (or the daily
#      cron). With both vars blank it just writes data/prospects/last-followups.txt.
#   2. analysis complete — after `./scripts/prospects.sh analyze <id>` a RICH alert
#      (client name, URL, overall score + tier, top 3 findings, the biggest-win line,
#      the AI lead score if present, and the saved report path). With both vars blank
#      it just writes data/prospects/last-analysis-alert.txt.
#   PROSPECTS_UPTIME_KUMA_PUSH_URL   an Uptime Kuma "push" monitor URL (your dashboard)
#   PROSPECTS_NOTIFY_CMD             your own command; the message on stdin, a short
#                                    label as $1 (e.g. the Telegram bot bridge — to
#                                    message YOURSELF). Keep tokens out of git.
#   PROSPECTS_REPORT_LOCALE          analysis-alert language: ar (default) | en
#                                    (overridable per run with `analyze --locale`)
PROSPECTS_UPTIME_KUMA_PUSH_URL=
PROSPECTS_NOTIFY_CMD=
PROSPECTS_REPORT_LOCALE=

# --- The FULL automated flow:  ./scripts/prospects.sh analyze <id> --notify -------
# One command runs the whole pipeline end to end — audit -> verdict -> optional AI ->
# Markdown (+ optional PDF) report saved -> rich alert pushed to YOUR channel (above)
# -> follow-up reminder set. The operator still ADDS prospects manually and CONTACTS
# them manually (the tool only renders a copy-paste draft; it never messages anyone).
#   PROSPECTS_FOLLOWUP_DAYS          how many days out the auto follow-up reminder is
#                                    set on a --notify run (default 3).
#   PROSPECTS_REPORT_PDF             1 = also export a PDF on every analyze (same as
#                                    passing --pdf). Off by default.
#   SEO_PDF_RENDERER                 (shared with the SEO auditor) the OPTIONAL,
#                                    opt-in Markdown->PDF renderer. Unset = keep the
#                                    print-ready HTML + Markdown (no heavy renderer on
#                                    the Pi). See services/seo/README.md.
PROSPECTS_FOLLOWUP_DAYS=
PROSPECTS_REPORT_PDF=

# ---------------------------------------------------------------------------
# CONTROL API (secure backend for the web control panel)
# ---------------------------------------------------------------------------
# Used by services/control-api/control-api.compose.yml — the API-only backend the
# future web control panel calls. It publishes NO host ports and is reached only
# via Caddy at api.<BASE_DOMAIN>. Start with ./scripts/control-api.sh up.
#
# SECURITY: every endpoint except GET /api/health requires a valid Keycloak JWT;
# all writes/actions/config-changes additionally require the operator role. The API
# is NEVER given the Docker socket — control + restart actions run on the host
# through the audited bot-exec.sh bridge over SSH (the same path the Telegram bot
# uses). It manages ONLY the allowlisted .env keys in
# services/control-api/config-registry.json and never returns/logs secret values.
# NONE of the values below are committed; this is a DEFERRED one-time setup.

# --- Keycloak / OIDC trust anchors (DEFERRED — create a client first) -------
# Create a Keycloak client for the control panel (e.g. "control-panel"), then set:
#   CONTROL_API_OIDC_ISSUER     the realm issuer URL the API validates tokens against
#                               (e.g. https://auth.<BASE_DOMAIN>/realms/<realm>)
#   CONTROL_API_OIDC_AUDIENCE   the expected token audience (usually the client id)
#   CONTROL_API_OIDC_JWKS_URI   OPTIONAL override; defaults to
#                               <issuer>/protocol/openid-connect/certs
#   CONTROL_API_OPERATOR_ROLE   the role that grants write/control access (default: operator)
# Until ISSUER + AUDIENCE are set the API fails CLOSED (it refuses to authenticate
# rather than allow access). Assign the operator role to your own user.
CONTROL_API_OIDC_ISSUER=
CONTROL_API_OIDC_AUDIENCE=
CONTROL_API_OIDC_JWKS_URI=
CONTROL_API_OPERATOR_ROLE=

# --- Browser login for the PANEL UI (control-panel part #2, DEFERRED) -------
# The panel performs Authorization Code + PKCE in the browser via a server-side
# BFF (/api/auth/*) and keeps tokens in an httpOnly, encrypted session cookie —
# the browser never sees a token. Reuse the SAME Keycloak realm as above (ISSUER).
# On the panel's Keycloak client set the redirect URI to https://api.<DOMAIN>/api/auth/callback.
# Public client (recommended): leave CLIENT_SECRET blank (PKCE protects the
# exchange). Confidential client: set CLIENT_SECRET. CLIENT_ID is usually the same
# value as CONTROL_API_OIDC_AUDIENCE so the access token the API verifies matches.
#   CONTROL_API_OIDC_CLIENT_ID                 the panel's Keycloak client id
#   CONTROL_API_OIDC_CLIENT_SECRET             blank for a public (PKCE) client
#   CONTROL_API_OIDC_REDIRECT_URI              https://api.<BASE_DOMAIN>/api/auth/callback
#   CONTROL_API_OIDC_APP_BASE_URL              https://api.<BASE_DOMAIN>
#   CONTROL_API_OIDC_POST_LOGOUT_REDIRECT_URI  where to land after logout (optional)
#   CONTROL_API_OIDC_SCOPE                     default "openid profile email"
#   CONTROL_API_SESSION_SECRET                 REQUIRED to encrypt the session cookie
#                                              (32+ random chars; e.g. openssl rand -hex 32)
#   CONTROL_API_OIDC_SESSION_MAX_AGE           session lifetime in seconds (default 28800 = 8h)
# Until CLIENT_ID + REDIRECT_URI + SESSION_SECRET are set, the panel shows a
# "not configured yet" gate and the /api/auth/* routes return 503 (fail closed).
CONTROL_API_OIDC_CLIENT_ID=
CONTROL_API_OIDC_CLIENT_SECRET=
CONTROL_API_OIDC_REDIRECT_URI=
CONTROL_API_OIDC_APP_BASE_URL=
CONTROL_API_OIDC_POST_LOGOUT_REDIRECT_URI=
CONTROL_API_OIDC_SCOPE=
CONTROL_API_SESSION_SECRET=
CONTROL_API_OIDC_SESSION_MAX_AGE=
# How often the Overview vitals (status + system-health) auto-refresh, in ms
# (client-side; min 1000, default 5000). Exposed to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_CONTROL_PANEL_POLL_MS=

# --- Constrained execution bridge to the host (DEFERRED — like the bot) -----
# The API runs control/restart actions on the host ONLY via scripts/bot-exec.sh
# over SSH with a DEDICATED key pinned to a forced command (no Docker socket, no
# arbitrary commands). Generate a key at ./secrets/control-api/bridge_key, add its
# PUBLIC half to the host authorized_keys as:
#   command="bash /PATH/scripts/bot-exec.sh --from-ssh",no-pty,... <pubkey>
# then set the host/user below. Mode "ssh" (default) uses this path; "local" is for
# dev only (an explicitly mounted bot-exec.sh).
#   (local: leave HOST/USER blank | prod: the Pi's address + the bridge user)
CONTROL_API_BRIDGE_MODE=
CONTROL_API_BRIDGE_SSH_HOST=
CONTROL_API_BRIDGE_SSH_USER=
CONTROL_API_BRIDGE_SSH_PORT=
# Path INSIDE the container to the private key (default /app/secrets/bridge_key,
# provided by the read-only ./secrets/control-api mount). Leave blank for default.
CONTROL_API_BRIDGE_SSH_KEY=

# --- Project GENERATION bridge (DEFERRED — its OWN dedicated forced key) -----
# Project creation (POST /api/projects, the New-Project wizard) reaches the host
# through a SIBLING script, scripts/bot-exec-generate.sh, that maps a strictly-
# validated create-project request to scripts/new-project.sh (no Docker socket, no
# shell, NEVER --force). Because one SSH key = one forced command, give it its OWN
# key. Generate ./secrets/control-api/generate_bridge_key, add its PUBLIC half to
# the host authorized_keys as:
#   command="bash /PATH/scripts/bot-exec-generate.sh --from-ssh",no-pty,... <pubkey>
# HOST/USER/PORT default to the main bridge's (same Pi) when blank; the KEY does not.
# Leave all blank to use those defaults (key -> /app/secrets/generate_bridge_key).
CONTROL_API_GENERATE_BRIDGE_MODE=
CONTROL_API_GENERATE_BRIDGE_SSH_HOST=
CONTROL_API_GENERATE_BRIDGE_SSH_USER=
CONTROL_API_GENERATE_BRIDGE_SSH_PORT=
CONTROL_API_GENERATE_BRIDGE_SSH_KEY=
# Generation is slower than a control action (scaffold + compose validation);
# default timeout is 300000 ms (5 min). Leave blank for the default.
CONTROL_API_GENERATE_BRIDGE_TIMEOUT_MS=

# --- Container user (so the config manager can write the bind-mounted .env) --
# The API runs as this uid:gid and must MATCH the owner of .env (chmod 600). On a
# typical Pi the login user is 1000:1000 (the default). Set if yours differs.
CONTROL_API_UID=
CONTROL_API_GID=

# --- Throttling for state-changing + config-writing endpoints --------------
# Fixed-window per-identity limit. Optional — sane defaults apply when blank.
#   (suggested: 60000 ms window, 20 requests)
CONTROL_API_RATE_WINDOW_MS=
CONTROL_API_RATE_MAX=
# Read endpoints (the live Monitoring/Growth feeds) get a separate, generous
# bucket so polling stays smooth. Optional (default 60000 ms window, 300 req).
CONTROL_API_READ_RATE_WINDOW_MS=
CONTROL_API_READ_RATE_MAX=

# --- Read-feed cache (coalesces repeated polls into one host call) ----------
# The panel polls the read-only Monitoring/Growth feeds every few seconds, often from
# several widgets/tabs at once. A tiny bounded in-memory TTL cache serves identical reads
# from memory within the TTL instead of making a fresh SSH round-trip each time. Caches
# only non-secret, host-global read RESULTS (never writes, never per-identity). Optional.
#   CONTROL_API_READ_CACHE_TTL_MS  cache lifetime in ms (default 2000; set 0 to DISABLE)
#   CONTROL_API_READ_CACHE_MAX     max cached entries before the oldest is evicted (default 64)
CONTROL_API_READ_CACHE_TTL_MS=
CONTROL_API_READ_CACHE_MAX=

# --- Privacy-first analytics summary (Umami) — DEFERRED, read-only ----------
# OPTIONAL. The Growth → Analytics view shows a cookie-less summary fetched
# server-side from the self-hosted Umami over the INTERNAL network. Set ALL four
# to enable it; leave blank and the panel shows a clean "not configured" state.
# The credentials stay on the API server and are NEVER returned to the browser.
#   URL: the internal address (e.g. http://umami:3000). USERNAME/PASSWORD: a
#   read-capable Umami user. WEBSITE_ID: the Umami website UUID to summarize.
CONTROL_API_ANALYTICS_UMAMI_URL=
CONTROL_API_ANALYTICS_UMAMI_USERNAME=
CONTROL_API_ANALYTICS_UMAMI_PASSWORD=
CONTROL_API_ANALYTICS_WEBSITE_ID=

# ---------------------------------------------------------------------------
# WHATSAPP BUSINESS (integration credentials — managed via the Control API)
# ---------------------------------------------------------------------------
# Credentials for the (DEFERRED, planned) WhatsApp Business API integration used by
# generated projects. They are NOT consumed by any always-on platform service — a
# project reads them on its next deploy — so changing them needs NO restart. These
# are listed here as EMPTY TEMPLATES so the Control API's integration manager can
# set them safely (allowlisted in config-registry.json, secrets masked, .env backed
# up + written atomically). ⚠ Requires an approved WhatsApp Business account.
# NEVER commit real values.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# LOCAL PAYMENTS (integration credentials — managed via the Control API)
# ---------------------------------------------------------------------------
# Credentials for the (DEFERRED, planned) local payment gateway integration used by
# generated projects (e.g. Moyasar for mada / STC Pay / cards). Like WhatsApp above
# they are consumed by a project on its next deploy, so no platform service needs
# restarting. Listed as EMPTY TEMPLATES for the Control API integration manager
# (allowlisted, secrets masked, atomic .env writes). ⚠ Requires an approved merchant
# account. NEVER commit real values.
#   PAYMENTS_PROVIDER          moyasar | none  (blank/none disables the integration)
#   PAYMENTS_API_KEY           SECRET server-side key (usage billed on your account)
#   PAYMENTS_PUBLISHABLE_KEY   the public/client key (not secret)
#   PAYMENTS_WEBHOOK_SECRET    SECRET used to verify incoming payment webhooks
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=
PAYMENTS_PUBLISHABLE_KEY=
PAYMENTS_WEBHOOK_SECRET=
